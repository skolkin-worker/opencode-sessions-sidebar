{
  "name": "opencode-sessions-sidebar",
  "version": "0.1.0",
  "description": "OpenCode TUI plugin displaying active sessions list in the sidebar",
  "type": "module",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "config": {
        "enabled": true
      }
    }
  },
  "files": [
    "dist",
    "src",
    "install.mjs",
    "README.md"
  ],
  "bin": {
    "opencode-sessions-sidebar": "install.mjs"
  },
  "scripts": {
    "build": "tsc && node build.tui.mjs",
    "build:tui": "node build.tui.mjs",
    "typecheck": "tsc --noEmit",
    "version": "node gen-version.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "sessions",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mangome/opencode-sessions-sidebar.git"
  },
  "license": "MIT",
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0",
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.28",
    "esbuild": "^0.25.0",
    "esbuild-plugin-solid": "^0.5.0",
    "tsx": "^4.22.3",
    "typescript": "^5.8.0"
  }
}
